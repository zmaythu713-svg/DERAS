@startuml DERAS_UseCase_Admin_Super
!theme plain
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam shadowing false
title DERAS — Use Case Diagram\n(Admin and Super Admin)

left to right direction

actor "Admin" as Admin
actor "Super Admin" as Super

' Super Admin inherits all Admin associations
Super --|> Admin

rectangle "DERAS System" {
  usecase "Login" as UC_Login
  usecase "Logout" as UC_Logout
  usecase "Manage Profile" as UC_Profile
  usecase "View Dashboard" as UC_Dash

  usecase "Manage Academic Years" as UC_Year
  usecase "Rollover Academic Year" as UC_Rollover
  usecase "Manage Townships" as UC_Town
  usecase "Manage Grades / Subjects" as UC_Grade
  usecase "Manage Book Names" as UC_Book
  usecase "Manage Company Contacts" as UC_Company
  usecase "Manage Admin Users" as UC_Users

  usecase "Manage Student Quota" as UC_Quota
  usecase "Manage Allocation Plans" as UC_Alloc
  usecase "Calculate Township Allocation" as UC_Calc
  usecase "Manage Textbooks" as UC_TB
  usecase "Sync Textbook from Plan" as UC_Sync
  usecase "Manage Stocks" as UC_Stock

  usecase "Manage School Supplies" as UC_SS
  usecase "Manage Supply Details" as UC_SD

  usecase "Manage Teacher Guide Receipt" as UC_TG_Recv
  usecase "Manage Teacher Guide Distribution" as UC_TG_Dist
  usecase "Manage Teacher Guide Issues" as UC_TG_Issue
  usecase "Manage Teacher Guide Summaries" as UC_TG_Sum
}

' —— Admin (day-to-day) ——
Admin --> UC_Login
Admin --> UC_Logout
Admin --> UC_Profile
Admin --> UC_Dash
Admin --> UC_Year
Admin --> UC_Town
Admin --> UC_Grade
Admin --> UC_Book
Admin --> UC_Company
Admin --> UC_Quota
Admin --> UC_Alloc
Admin --> UC_TB
Admin --> UC_Stock
Admin --> UC_SS
Admin --> UC_SD
Admin --> UC_TG_Recv
Admin --> UC_TG_Dist
Admin --> UC_TG_Issue
Admin --> UC_TG_Sum

' —— Super Admin only (in addition to inherited Admin use cases) ——
Super --> UC_Users
Super --> UC_Rollover
Super --> UC_Calc
Super --> UC_Sync

' —— «include» ——
UC_Year ..> UC_Rollover : «include»
UC_Alloc ..> UC_Calc : «include»
UC_TB ..> UC_Sync : «include»
UC_TG_Dist ..> UC_TG_Recv : «include»
UC_TG_Issue ..> UC_TG_Dist : «include»

note right of Super
  Super Admin inherits Admin,
  and additionally:
  - Manage Admin Users
  - Rollover Academic Year
  - Calculate Township Allocation
  - Sync Textbook from Plan
end note

@enduml
